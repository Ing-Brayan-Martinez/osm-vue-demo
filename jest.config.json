{
  "rootDir": "./test",
  "moduleFileExtensions": [
    "js",
    "jsx",
    "mjs",
    "json"
  ],
  "transform": {
    "^.+\\.(js|jsx)$": "babel-jest"
  },
  "transformIgnorePatterns": [
    "<rootDir>/node_modules/"
  ],
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "collectCoverage": false,
  "coverageReporters": [
    "html",
    "text"
  ],
  "coverageDirectory": "./coverage",
  "coveragePathIgnorePatterns": [
    "/node_modules/"
  ]
}
